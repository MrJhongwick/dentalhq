# Neon pooled connection string for normal API queries.
# Copy the value from the Neon dashboard's pooled connection details.
DATABASE_URL="postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"

# Neon direct connection string for Drizzle migrations and administrative tasks.
# This hostname must not contain the `-pooler` suffix.
DATABASE_URL_UNPOOLED="postgresql://<role>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"

# Generate a random secret of at least 32 characters; do not use the placeholder.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3003"
TRUSTED_ORIGINS="http://localhost:3001,http://localhost:3002"

# Synthetic in-memory demo only; choose a local password of at least 12 characters.
DEVELOPMENT_PASSWORD=""

# Initial operator bootstrap CLI only. Remove the password after bootstrap.
BOOTSTRAP_NAME=""
BOOTSTRAP_EMAIL=""
BOOTSTRAP_PASSWORD=""
