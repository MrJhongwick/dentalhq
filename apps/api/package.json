{
  "name": "@dentalhq/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --format=esm --platform=neutral --outdir=dist",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test scripts/database-config.test.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx scripts/check-db.ts"
  },
  "dependencies": {
    "@hono/node-server": "latest",
    "hono": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "esbuild": "latest",
    "pg": "^8.23.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
