{
  "name": "@dentalhq/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/dev.ts --bundle --format=esm --platform=node --packages=external --outdir=dist",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test scripts/database-config.test.ts src/app.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "operator:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-operator.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx scripts/check-db.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@dentalhq/contracts": "workspace:*",
    "@dentalhq/db": "workspace:*",
    "@hono/node-server": "latest",
    "better-auth": "^1.7.3",
    "hono": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "esbuild": "latest",
    "pg": "^8.23.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
