{
  "name": "dentalhq",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive --if-present test",
    "check": "pnpm typecheck && pnpm test",
    "db:check": "pnpm --filter @dentalhq/api db:check",
    "dev": "pnpm --parallel --recursive dev",
    "dev:api": "pnpm --filter @dentalhq/api dev",
    "dev:console": "pnpm --filter @dentalhq/console dev",
    "dev:dashboard": "pnpm --filter @dentalhq/dashboard dev",
    "dev:landing": "pnpm --filter @dentalhq/landing dev"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
